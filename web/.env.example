# Copy to .env.local (gitignored). Values come from the Firebase console: Project settings -> Your apps -> Web app.
# These identify your project; they are not secrets, but keep them out of the repo anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Web push certificate (Project settings -> Cloud Messaging -> Web Push certificates)
VITE_FIREBASE_VAPID_KEY=
# Set to true to talk to the local emulators (firebase emulators:start)
VITE_USE_EMULATORS=false
